{
  "name": "crew",
  "version": "0.1.0",
  "description": "A terminal UI for orchestrating multiple Claude agents on your subscription",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "crew": "./src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "dev": "bun run src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:verify": "bun run scripts/smoke-verify.ts",
    "smoke:route": "bun run scripts/smoke-route.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@inkjs/ui": "^2.0.0",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
